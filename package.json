{
  "name": "shimweave",
  "version": "0.0.1",
  "private": true,
  "description": "在浏览器本地为网页播放器补齐媒体格式兼容能力，媒体数据保持源站或 CDN 直达浏览器。",
  "license": "GPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "package:extension": "pnpm build && node scripts/package-extension.mjs",
    "benchmark:control": "pnpm --filter @shimweave/io-fetch build && node scripts/benchmark-control-v1.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/chrome": "0.2.7",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
